# ─── Server Configuration ─────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database Configuration ───────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=SZ
DB_POOL_MAX=5
DB_SSL=false
# Set DB_SSL=true for cloud-hosted PostgreSQL (AWS RDS, Supabase, Neon, etc.)

# ─── Redis Configuration ──────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://username:password@host:port  (for cloud Redis like Upstash)

# ─── JWT Configuration (REQUIRED) ─────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_64_byte_hex_secret
JWT_REFRESH_SECRET=CHANGE_ME_generate_another_64_byte_hex_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── API Rate Limiter ─────────────────────────────────────────
# In production, rate limiting is always ON regardless of this toggle
RATE_LIMIT=OFF
API_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# ─── Razorpay Configuration ───────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── Email Configuration ──────────────────────────────────────
# Option 1: Resend (recommended) — set RESEND_API_KEY
# Option 2: Gmail — set EMAIL_USER + EMAIL_PASS (App Password)
RESEND_API_KEY=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=YourApp <your-email@gmail.com>

# ─── Cloudinary Configuration ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── WhatsApp Cloud API (Meta Business) ───────────────────────
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# ─── Security Toggle ──────────────────────────────────────────
# In production, OTP verification is always ON regardless of this toggle
OTP_VERI=OFF

# ─── Frontend URL ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
