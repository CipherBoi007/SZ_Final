# ─── Database Credentials ─────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=choose_a_strong_password_here
DB_NAME=southzone

# ─── JWT Security ─────────────────────────────────────────────
# Generate 64-byte hex values using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_hex
JWT_REFRESH_SECRET=your_jwt_refresh_secret_hex
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Payment Gateway ──────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_yourkey
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Cloudinary Uploads ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── WhatsApp API ─────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_id

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_secret

# ─── Email Configuration ──────────────────────────────────────
# E.g. Resend or Gmail SMTP
RESEND_API_KEY=re_your_resend_key
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# ─── Production URLs ──────────────────────────────────────────
# Important: FRONTEND_URL must be the actual domain name (e.g., https://southzone.in)
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_yourkey
NEXT_PUBLIC_OTP_VERI=ON
